@inherits LayoutComponentBase

<!-- Minimal layout: full white background, center content -->
<div style="min-height:100vh; background-color: #ffffff; color: #000;">
    <main style="max-width:900px; margin:0 auto; padding:4rem 1rem;">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
